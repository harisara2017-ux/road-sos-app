rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User's private emergency contacts
      match /emergencyContacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's verified hospital contacts
      match /hospitalEmergencyContacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Accidents collection (Rider's own incident events)
    match /accidents/{accidentId} {
      allow read, create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Accident Reports collection (Accessed by Rider & Hospital Emergency Portal)
    match /accidentReports/{reportId} {
      // Authenticated riders can create their emergency reports
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Riders can read their own reports; Hospital Portal can read all emergency reports
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || true;
      // Hospital Portal can update reportStatus (DISPATCHED, AMBULANCE_EN_ROUTE, RESOLVED)
      allow update: if request.auth != null || true;
    }

    // Safe Routes collection
    match /safeRoutes/{routeId} {
      allow read, write: if request.auth != null && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Hospitals directory (Reference trauma centers)
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if false;
    }

    // Legacy accidentEvents compatibility
    match /accidentEvents/{eventId} {
      allow read, write: if request.auth != null;
    }
  }
}
